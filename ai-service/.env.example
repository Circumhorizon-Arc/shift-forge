# HealthSense AI Service Configuration

# LLM Provider Configuration
# Supported providers: "mock" (for offline/testing), "openai" (OpenAI, Groq, Ollama, vLLM), "gemini"
LLM_PROVIDER=mock

# OpenAI / OpenAI-compatible configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Model Parameters
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.1

# Document Processing & Security Limits
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=[".pdf", ".png", ".jpg", ".jpeg"]
MIN_EXTRACTABLE_TEXT_CHARS=20

# OCR Settings
# Path to tesseract executable if not in PATH (e.g., /opt/homebrew/bin/tesseract or /usr/bin/tesseract)
TESSERACT_CMD=

# Server Settings (for standalone FastAPI service)
HOST=0.0.0.0
PORT=8001
DEBUG=False
