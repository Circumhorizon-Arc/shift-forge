# HealthSense AI Service Configuration
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Supported: "mock" (no API key, for CI/testing), "gemini", "openai"
LLM_PROVIDER=mock

# OpenAI / OpenAI-compatible (Groq, Ollama, Azure, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Model parameters
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Document Processing & Security
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=[".pdf", ".png", ".jpg", ".jpeg"]
MIN_EXTRACTABLE_TEXT_CHARS=20

# OCR: explicit path to tesseract binary if not discoverable in PATH
TESSERACT_CMD=

# ---------------------------------------------------------------------------
# Server settings
# ---------------------------------------------------------------------------
# Local development: 127.0.0.1 (loopback only)
# Container / production: 0.0.0.0 (ensure network policy restricts external exposure)
HOST=127.0.0.1
PORT=8001
DEBUG=False

# ---------------------------------------------------------------------------
# CORS (browser access control)
# ---------------------------------------------------------------------------
# Comma-separated list of trusted browser origins. Do NOT use * in production.
# Server-to-server calls from the main backend are not affected by this setting.
# Example (production): CORS_ORIGINS=https://app.healthsense.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ---------------------------------------------------------------------------
# Internal service authentication
# ---------------------------------------------------------------------------
# Protects GET /api/v1/uploads. Generate with: openssl rand -hex 32
# Share with the main backend; include as "Authorization: Bearer <token>" header.
# Leave empty to disable the uploads endpoint entirely (recommended default).
INTERNAL_SERVICE_TOKEN=
