# Server Settings
PROJECT_NAME="ShiftForge Healthcare API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# Database (PostgreSQL URL format: postgresql://user:password@localhost:5432/shiftforge_db)
# Falls back to sqlite:///./shiftforge.db for quick local development if postgres is not provided
DATABASE_URL="sqlite:///./shiftforge.db"

# JWT Security
SECRET_KEY="super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Google Gemini & AI Microservice)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
AI_SERVICE_URL="http://localhost:8001"

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg"]

# CORS Origins (Comma-separated for multiple URLs)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
